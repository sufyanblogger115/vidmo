# --- Core ---
NODE_ENV=production
PORT=3000
NEXTAUTH_URL=https://your-app.up.railway.app
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# --- Database (Railway Postgres plugin sets DATABASE_URL automatically) ---
DATABASE_URL=postgresql://user:password@localhost:5432/vidmorphx
# For local dev without Postgres, you can point Prisma at SQLite instead:
# DATABASE_URL=file:./dev.db

# --- Redis / Queue (Railway Redis plugin sets REDIS_URL automatically) ---
REDIS_URL=redis://localhost:6379

# --- Gemini (used for transcription/subtitles, title/description/hashtag generation) ---
GEMINI_API_KEY=your-gemini-api-key

# --- OAuth (leave blank to disable that provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Storage (local disk by default; point to a mounted Railway volume) ---
UPLOAD_DIR=/data/uploads
OUTPUT_DIR=/data/outputs
MAX_UPLOAD_MB=2048
